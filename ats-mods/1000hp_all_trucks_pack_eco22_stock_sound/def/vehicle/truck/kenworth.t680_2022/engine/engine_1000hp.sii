    torque_curve[]: (2600, 0.48)
    torque_curve[]: (2800, 0)
    volume: 16.0

    # RPM limits and transmission shift points
    rpm_idle: 600
    rpm_limit: 2800
    rpm_limit_neutral: 2500
    rpm_range_low_gear: (1000, 1700)
    rpm_range_high_gear: (1200, 1900)
    rpm_range_power: (1400, 2100)

    # Engine braking
    engine_brake: 3.0
    engine_brake_downshift: 1
