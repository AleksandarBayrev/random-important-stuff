    info[]: "1,000 @@hp@@ (745 kW)"
    info[]: "3,319 @@lb_ft@@ (4,500 Nm)"
    info[]: "1,000-1,500 @@rpm@@"

    # Engine performance specs
    torque: 4500

    # Torque multipliers relative to 4500 Nm; tuned for 1000-2000 RPM.
